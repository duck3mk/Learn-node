<%- include('./partials/head.ejs')%>

  <div class="page-wrap">
    <div class="card">
      <h2><%= note.title %></h2>
      <p><%= note.desc %></p>
      <button class="d" data-doc="<%= note._id %>">Delete</button>
    </div>
  </div>

  <script>
    const del = document.querySelector('.d')

    del.addEventListener("click", (e) => {
      const point = `/home/${del.dataset.doc}`;

      fetch(point, {
        method: 'DELETE'
      })
      .then(response => response.json())
        .then(data => {
          console.log(data)
          location.assign('/')
        })
      .catch(err => {console.log(err)})
    })
  </script>

  <%- include('./partials/bottom.ejs') %>